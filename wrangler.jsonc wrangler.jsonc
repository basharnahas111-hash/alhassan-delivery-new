{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alhassan-delivery-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",

  "kv_namespaces": [
    {
      "binding": "ALHASSAN_DATA",
      "id": "87dfd01f9fc04fa7bfba947a4b207412"
    }
  ],

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
