{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alhassan-delivery-new",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",

  "kv_namespaces": [
    {
      "binding": "ALHASSAN_DATA",
      "id": "e743f54bcedf4cd189cdc6146981d5ba"
    }
  ],

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
